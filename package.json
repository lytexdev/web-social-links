{
  "name": "web-social-links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "node scripts/build-icon-index.ts && nuxt dev",
    "build": "node scripts/build-icon-index.ts && nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare && node scripts/build-icon-index.ts",
    "lint": "eslint . && prettier --check . && node scripts/check-text.mjs",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@tabler/icons": "3.50.0",
    "@tabler/icons-vue": "3.50.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-de": "4.1.1",
    "@zxcvbn-ts/language-en": "4.1.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "file-type": "22.3.0",
    "h3": "1.15.11",
    "isbot": "5.2.2",
    "markdown-it": "15.0.3",
    "nuxt": "4.6.3",
    "ofetch": "1.5.1",
    "otpauth": "9.5.2",
    "reka-ui": "2.11.0",
    "sharp": "0.35.5",
    "simple-icons": "16.36.0",
    "uqr": "0.1.3",
    "vue": "3.5.44",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
